{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteGraph",
  "description": "IdeaHammer 路由图 — 替代 8 步线性流水线，支持并发 / 条件 / spike",
  "type": "object",
  "required": [
    "name",
    "entry",
    "nodes",
    "edges"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "路由图名称"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "entry": {
      "type": "string",
      "description": "入口节点 ID"
    },
    "state_schema": {
      "type": "object",
      "description": "节点间共享状态 schema",
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "skill"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "skill": {
            "type": "string",
            "description": "skill 名（如 product-spec-builder）"
          },
          "mode": {
            "type": "string",
            "enum": [
              "0-1",
              "iterate",
              "init",
              "continue"
            ],
            "description": "skill 启动模式"
          },
          "inputs": {
            "type": "object",
            "description": "从 state 取哪些字段作为输入",
            "additionalProperties": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "object",
            "description": "skill 输出写回 state 的哪些字段",
            "additionalProperties": {
              "type": "string"
            }
          },
          "parallel": {
            "type": "boolean",
            "default": false,
            "description": "本节点是否可与其他并行节点同时跑"
          },
          "spike": {
            "type": "boolean",
            "default": false,
            "description": "spike 节点（探查 / 实验），不进入正式产出物"
          },
          "max_retries": {
            "type": "integer",
            "default": 0
          },
          "timeout_seconds": {
            "type": "integer",
            "default": 3600
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "目标节点 ID 或多目标"
          },
          "condition": {
            "type": "string",
            "description": "条件表达式（Python 表达式，输入是 state，返回 bool）"
          },
          "priority": {
            "type": "integer",
            "default": 0,
            "description": "多目标边时的优先级"
          },
          "loop": {
            "type": "boolean",
            "default": false,
            "description": "true = 回路边（loop），如 review → bug-fix → review"
          }
        }
      }
    },
    "terminal": {
      "type": "array",
      "description": "终止节点（无出边的节点）",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}