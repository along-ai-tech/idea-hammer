{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodexHooksFile",
  "description": "Codex hooks.json 配置（openai/codex rust-v0.171.0 HooksFile）— 顶层只允许 description / hooks；本 schema 只覆盖 type=command 的 handler",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "可选说明文字，Codex 只解析不消费"
    },
    "hooks": {
      "type": "object",
      "description": "事件名 → MatcherGroup 数组。Codex 只识别下列 14 个事件名，其余键会被静默忽略；本 schema 直接判错，便于发现拼写错误",
      "properties": {
        "PreModelRequest": {
          "$ref": "#/definitions/matcherGroups"
        },
        "PostModelRequest": {
          "$ref": "#/definitions/matcherGroups"
        },
        "PreToolUse": {
          "$ref": "#/definitions/matcherGroups"
        },
        "PermissionRequest": {
          "$ref": "#/definitions/matcherGroups"
        },
        "PostToolUse": {
          "$ref": "#/definitions/matcherGroups"
        },
        "PreCompact": {
          "$ref": "#/definitions/matcherGroups"
        },
        "PostCompact": {
          "$ref": "#/definitions/matcherGroups"
        },
        "SessionStart": {
          "$ref": "#/definitions/matcherGroups"
        },
        "SessionEnd": {
          "$ref": "#/definitions/matcherGroups"
        },
        "UserPromptSubmit": {
          "$ref": "#/definitions/matcherGroups"
        },
        "SubagentStart": {
          "$ref": "#/definitions/matcherGroups"
        },
        "SubagentStop": {
          "$ref": "#/definitions/matcherGroups"
        },
        "Stop": {
          "$ref": "#/definitions/matcherGroups"
        },
        "Interrupt": {
          "$ref": "#/definitions/matcherGroups"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "matcherGroups": {
      "type": "array",
      "description": "同一事件下的 matcher 分组，按数组顺序执行",
      "items": {
        "$ref": "#/definitions/matcherGroup"
      }
    },
    "matcherGroup": {
      "type": "object",
      "required": [
        "hooks"
      ],
      "properties": {
        "matcher": {
          "type": "string",
          "description": "匹配 tool_name 的表达式：空串或 \"*\" 匹配全部；只含字母数字/下划线/竖线时按精确工具名匹配（竖线是「或」）；含正则字符时按正则匹配。仅 PreToolUse / PermissionRequest / PostToolUse / SessionStart / SessionEnd / SubagentStart / SubagentStop / PreCompact / PostCompact 生效，其余事件忽略此字段"
        },
        "hooks": {
          "type": "array",
          "description": "本分组下的 handler",
          "items": {
            "$ref": "#/definitions/hookHandler"
          }
        }
      },
      "additionalProperties": false
    },
    "hookHandler": {
      "type": "object",
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "command"
          ],
          "description": "handler 类型。Codex 还定义了 mcp_tool / prompt / agent，但本版本运行时全部跳过，本框架只用 command"
        },
        "command": {
          "type": "string",
          "description": "交给 shell 执行的命令，Codex 用 $SHELL -lc \"<command>\" 启动"
        },
        "commandWindows": {
          "type": "string",
          "description": "Windows 专用命令；不填则 command 在所有平台生效"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "超时秒数。默认 600；SessionEnd / Interrupt 默认 1 且上限 3"
        },
        "async": {
          "type": "boolean",
          "default": false,
          "description": "true = 异步执行。异步 hook 没有控制效果：不能拦截、不能改写输入、不能终止本轮，但仍可注入 additionalContext"
        },
        "statusMessage": {
          "type": "string",
          "description": "运行期间展示的状态提示"
        },
        "additionalContextLimit": {
          "type": "integer",
          "minimum": 0,
          "default": 2500,
          "description": "该 hook 注入上下文溢写到磁盘的近似 token 阈值；0 表示关闭溢写"
        }
      },
      "additionalProperties": false
    }
  }
}
