{
  "$version": "2.0",
  "$comment": "Hook 协议 v2 — advisory/transform/retry 三模式。详细见 schemas/hook-protocol.schema.json",
  "events": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/detect-feedback-signal.sh\"",
            "timeout": 5,
            "mode": "advisory"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/check-evolution.sh\"",
            "timeout": 10,
            "mode": "advisory"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "shell|local_shell|exec",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/pre-tool-shell.sh\"",
            "timeout": 30,
            "mode": "advisory"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "shell|local_shell|exec",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/auto-push.sh\"",
            "timeout": 15,
            "mode": "advisory"
          }
        ]
      },
      {
        "matcher": "apply_patch|edit|write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/mark-review-needed.sh\"",
            "timeout": 3,
            "mode": "advisory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/stop-gate.sh\"",
            "timeout": 5,
            "mode": "advisory"
          }
        ]
      }
    ]
  }
}