{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevPlannerOutput",
  "description": "DEV-PLAN.md 结构化输出",
  "type": "object",
  "required": ["technical_design", "phases", "tech_stack"],
  "properties": {
    "technical_design": {
      "type": "object",
      "description": "Technical-Design.md 的结构化摘要；新项目必填",
      "required": ["architecture_pattern", "modules", "domain_model", "data_model", "api_contract", "adrs", "risks"],
      "properties": {
        "architecture_pattern": {
          "type": "string",
          "enum": ["monolith", "modular_monolith", "microservices", "event_driven"],
          "description": "架构模式"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "responsibility"],
            "properties": {
              "name": {"type": "string"},
              "responsibility": {"type": "string"},
              "interfaces": {"type": "array", "items": {"type": "string"}},
              "depends_on": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "domain_model": {
          "type": "object",
          "required": ["entities", "aggregates", "invariants"],
          "properties": {
            "entities": {"type": "array", "items": {"type": "string"}},
            "value_objects": {"type": "array", "items": {"type": "string"}},
            "aggregates": {"type": "array", "items": {"type": "string"}},
            "bounded_contexts": {"type": "array", "items": {"type": "string"}},
            "invariants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["aggregate", "rule", "enforcement"],
                "properties": {
                  "aggregate": {"type": "string"},
                  "rule": {"type": "string"},
                  "enforcement": {"type": "string"}
                }
              }
            }
          }
        },
        "data_model": {
          "type": "object",
          "required": ["tables"],
          "properties": {
            "tables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "columns"],
                "properties": {
                  "name": {"type": "string"},
                  "columns": {"type": "array", "items": {"type": "string"}},
                  "constraints": {"type": "array", "items": {"type": "string"}},
                  "indexes": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "transactions": {"type": "string"},
            "concurrency": {"type": "string"},
            "soft_delete": {"type": "string"},
            "audit_fields": {"type": "array", "items": {"type": "string"}},
            "versioning": {"type": "string"}
          }
        },
        "api_contract": {
          "type": "object",
          "required": ["base_path", "endpoints", "error_model", "versioning"],
          "properties": {
            "base_path": {"type": "string"},
            "openapi_path": {"type": "string"},
            "endpoints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["method", "path"],
                "properties": {
                  "id": {"type": "string"},
                  "method": {"type": "string"},
                  "path": {"type": "string"},
                  "permission": {"type": "string"},
                  "request": {"type": "array", "items": {"type": "string"}},
                  "response": {"type": "array", "items": {"type": "string"}},
                  "errors": {"type": "array", "items": {"type": "string"}},
                  "idempotent": {"type": "boolean"}
                }
              }
            },
            "error_model": {"type": "object"},
            "versioning": {"type": "string"},
            "mock": {"type": "string"}
          }
        },
        "adrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "status", "context", "decision", "alternatives", "tradeoffs", "consequences"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "status": {"type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"]},
              "context": {"type": "string"},
              "decision": {"type": "string"},
              "alternatives": {"type": "array", "items": {"type": "string"}},
              "tradeoffs": {"type": "string"},
              "consequences": {"type": "string"},
              "revisit_trigger": {"type": "string"}
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["risk", "impact", "mitigation"],
            "properties": {
              "id": {"type": "string"},
              "risk": {"type": "string"},
              "impact": {"type": "string"},
              "probability": {"type": "string", "enum": ["high", "medium", "low"]},
              "mitigation": {"type": "string"},
              "trigger": {"type": "string"},
              "fallback": {"type": "string"}
            }
          }
        }
      }
    },
    "tech_stack": {
      "type": "object",
      "description": "技术栈最终选型",
      "properties": {
        "language": {"type": "string"},
        "framework": {"type": "string"},
        "ui_library": {"type": "string"},
        "database": {"type": "string"},
        "package_manager": {"type": "string"},
        "deploy_target": {"type": "string"}
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "name", "deliverables", "key_files"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 3},
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 5}
          },
          "key_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "依赖的 Phase 编号"
          },
          "verification": {"type": "string"},
          "verification_evidence": {"type": "array", "items": {"type": "string"}},
          "parallel_with": {"type": "array", "items": {"type": "integer"}},
          "risks": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": false
}
