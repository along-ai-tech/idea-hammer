{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignMakerOutput",
  "description": "design-maker 交付物结构",
  "type": "object",
  "required": ["design_variables", "components", "pages", "page_states"],
  "properties": {
    "design_variables": {
      "type": "object",
      "description": "设计变量（颜色 / 字体 / 间距 / 圆角）",
      "properties": {
        "colors": {"type": "object"},
        "typography": {"type": "object"},
        "spacing": {"type": "object"},
        "radius": {"type": "object"}
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "states"],
        "properties": {
          "name": {"type": "string"},
          "states": {"type": "array", "items": {"type": "string"}},
          "screenshot_path": {"type": "string"}
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "states"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "states": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "page_states": {
      "type": "object",
      "description": "页面状态变体覆盖"
    },
    "completeness_check": {
      "type": "object",
      "properties": {
        "spec_features_covered": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}
