{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseOutput",
  "description": "release-builder 发布报告",
  "type": "object",
  "required": ["release_type", "version", "requirements", "tests", "artifact", "privacy_audit", "smoke_test"],
  "properties": {
    "release_type": {"type": "string", "enum": ["web", "desktop", "cli"]},
    "version": {"type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$"},
    "commit": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {"type": "string", "pattern": "^REQ-\\d{3}$"}
    },
    "tests": {
      "type": "object",
      "required": ["total", "passed", "ids"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "ids": {"type": "array", "items": {"type": "string", "pattern": "^TEST-\\d{3}$"}}
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "size_bytes": {"type": "integer"},
        "checksum": {"type": "string"}
      }
    },
    "privacy_audit": {
      "type": "object",
      "properties": {
        "developer_paths_found": {"type": "array", "items": {"type": "string"}},
        "data_files_found": {"type": "array", "items": {"type": "string"}},
        "credentials_found": {"type": "array", "items": {"type": "string"}},
        "passed": {"type": "boolean"}
      }
    },
    "install_test": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "method": {"type": "string"},
        "evidence": {"type": "string"}
      }
    },
    "smoke_test": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "scenarios": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rollback_plan": {"type": "string"}
  },
  "additionalProperties": false
}
